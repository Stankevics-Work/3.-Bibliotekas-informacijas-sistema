+            catch (SQLException e) { throw new AssertionError(e); } });
+        rejected(() -> { try { loans.issueBook(r1.getLietotajaId(), firstCopyId,
+              LocalDate.now().minusDays(1).toString(), staff); }
+            catch (SQLException e) { throw new AssertionError(e); } });
+        rejected(() -> { try { loans.issueBook(r1.getLietotajaId(), firstCopyId,
